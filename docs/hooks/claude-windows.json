{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PROJECT_DIR}/scripts/session_start.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
